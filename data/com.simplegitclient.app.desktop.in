[Desktop Entry]
Type=Application
Name=Simple Git Client
GenericName=Git Client
Comment=A native GTK4 Git GUI (GitKraken-style)
Exec=@EXEC@ %U
Icon=@ICON@
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;version control;commit;branch;diff;
StartupNotify=true
StartupWMClass=com.simplegitclient.app
